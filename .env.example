# ============================================================
# MSRIT AI Campus Policy Assistant — Environment Configuration
# ============================================================

# ── LLM Configuration ──────────────────────────────────────
# Option A: Self-Hosted Qwen 2.5-7B on Kaggle T4 GPU
#   1. Run the Kaggle notebook (see README.md for link)
#   2. Copy your Cloudflare/ngrok tunnel URL below
LLM_BASE_URL=https://ceremony-ending-spent-clicking.trycloudflare.com/v1
LLM_MODEL_NAME=qwen3.8:27b
LLM_API_KEY=ollama

# Option B: Groq Cloud (free tier, fast) — 1-line swap
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_API_KEY=gsk_your_groq_api_key_here
# LLM_MODEL_NAME=llama-3.1-8b-instant

# Option C: Google Gemini via OpenAI-compatible endpoint
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# LLM_API_KEY=your_gemini_api_key_here
# LLM_MODEL_NAME=gemini-1.5-flash

# Option D: OpenAI GPT-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_API_KEY=sk-your_openai_key_here
# LLM_MODEL_NAME=gpt-4o-mini

# ── Qdrant Vector DB ───────────────────────────────────────
QDRANT_PATH=./qdrant_storage
QDRANT_COLLECTION=msrit_policies

# ── Retrieval Thresholds ───────────────────────────────────
# Minimum reranker score to generate a response (below = refusal)
CONFIDENCE_THRESHOLD=0.60

# Number of candidates passed to cross-encoder reranker
TOP_K_RERANK=8

# Final number of chunks used for answer synthesis
FINAL_TOP_K=3

# ── MCP Server ─────────────────────────────────────────────
MCP_SERVER_SCRIPT=./src/mcp_server.py
